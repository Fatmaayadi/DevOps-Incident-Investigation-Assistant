# Copy this file to .env and fill in your own values. Never commit .env.
GROQ_API_KEY="your groq API key"

# Optional settings (defaults shown)
# LLM_MODEL=openai/gpt-oss-120b
# ANALYZER_MODEL and INVESTIGATOR_MODEL default to LLM_MODEL (the recorded benchmarks used the default)
# ANALYZER_MODEL=openai/gpt-oss-120b
# INVESTIGATOR_MODEL=openai/gpt-oss-120b
# JUDGE_MODEL=qwen/qwen3.8-27b
# PAIR_MODEL=openai/gpt-oss-20b
# EVIDENCE_MIN_SCORE=-2.86
# EVIDENCE_MIN_PASSAGES=3
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Leave QDRANT_URL empty to use the embedded local Qdrant stored in storage/qdrant.
# Set it to use a Qdrant server instead (see docker-compose.yml).
# QDRANT_URL=http://localhost:6333
